PORT=4000
DATABASE_URL=url
JWT_SECRET=change-me

# Supabase REST (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=service_role_key_here
# set to 1 to force REST adapter even when Postgres is reachable
FORCE_SUPABASE_REST=0
# set to 1 to disable local JSON fallback (recommended after migrating data)
DISABLE_FILE_FALLBACK=0

# Admin key for /admin endpoints
ADMIN_KEY=dev-admin-key
